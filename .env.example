# Text narrative provider. Use "responses" for OpenAI Responses API or
# "chat-completions" for an OpenAI-compatible gateway.
AI_PROTOCOL=responses
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_NARRATIVE_MODEL=gpt-5-mini
AI_ADJUDICATOR_MODEL=gpt-5-mini

# Optional event illustration provider. Leave empty to keep procedural scenes.
AI_IMAGE_MODEL=


# Optional shared-deployment guards. Leave empty/0 for private local use.
# SHARE_ACCESS_CODE: visitors must fill this code in Settings before AI requests.
SHARE_ACCESS_CODE=
# AI_DAILY_LIMIT: per-day, per-browser/visitor request cap kept in service memory only.
AI_DAILY_LIMIT=0